# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml defaults. Port 3307 avoids clashing with a local MySQL.
DATABASE_URL=mysql://medlab:medlab@localhost:3307/medlab
MYSQL_ROOT_PASSWORD=medlab
MYSQL_DATABASE=medlab
MYSQL_USER=medlab
MYSQL_PASSWORD=medlab
MYSQL_PORT=3307

# --- API --------------------------------------------------------------------
API_PORT=3001
# Sign the session cookie. Generate: openssl rand -base64 32
JWT_SECRET=change-me-in-production

# --- AI provider ------------------------------------------------------------
# 'ollama' = local/offline. 'opencode' = hosted, fast, needs OPENCODE_API_KEY.
# 'dr7' = hosted medical models (MedGemma), needs DR7_API_KEY.
AI_PROVIDER=ollama

OLLAMA_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=gemma3
OLLAMA_VISION_MODEL=llava

# Server-side only — NEVER prefix with VITE_, that would ship it to the browser.
# Free-tier model ids end in '-free' (e.g. deepseek-v4-flash-free, mimo-v2.5-free).
# The same id WITHOUT the suffix is the paid route and 401s with CreditsError until a
# payment method is added to the workspace.
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-flash-free

# dr7.ai medical-model gateway. Server-side only, same rule as above.
# Keys look like sk-dr7-…; 402 means the account balance is empty.
# medgemma-4b-it is multimodal, so it covers the symptom-checker photo path.
DR7_BASE_URL=https://dr7.ai/api/v1/medical
DR7_API_KEY=
DR7_MODEL=medgemma-4b-it
# dr7's undocumented default is 1000 and truncates Tetum answers mid-JSON.
DR7_MAX_TOKENS=2048
